mdl 1.7;

import ::base::*;
import ::df::*;
import ::math::*;

export material unsupported_color_layer(
    color background = color(0.1, 0.3, 0.5),
    color foreground = color(0.8, 0.2, 0.1),
    float weight = 0.4
) = let {
    color result = base::blend_color_layers(
        layers: base::color_layer[](
            base::color_layer(foreground, weight, base::color_layer_hue)
        ),
        base: background
    ).tint;
} in material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: math::pow(result, color(2.0))
        )
    )
);
