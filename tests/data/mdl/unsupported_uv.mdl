mdl 1.7;

import ::base::*;
import ::df::*;
import ::tex::*;

export material unsupported_uv() = material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: base::file_texture(
                texture_2d("textures/checker.png", tex::gamma_linear),
                uvw: base::coordinate_source(base::texture_coordinate_object)
            ).tint
        )
    )
);
