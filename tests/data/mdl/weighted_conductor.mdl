mdl 1.7;

import ::df::*;

export material weighted_conductor(float weight = 0.0) = material(
    surface: material_surface(
        scattering: df::weighted_layer(
            weight: weight,
            base: df::diffuse_reflection_bsdf(tint: color(0.8, 0.0, 0.0)),
            layer: df::fresnel_factor(
                ior: color(0.3),
                extinction_coefficient: color(3.0),
                base: df::microfacet_ggx_smith_bsdf(roughness_u: 0.15)
            )
        )
    )
);
