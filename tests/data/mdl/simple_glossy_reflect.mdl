mdl 1.7;

import ::df::*;
import ::state::*;

export material simple_glossy_reflect(
    float roughness_u = 0.36,
    float roughness_v = 0.04
) = material(
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(
            roughness_u: roughness_u,
            roughness_v: roughness_v,
            tangent_u: state::texture_tangent_u(0),
            tint: color(0.8),
            mode: df::scatter_reflect
        )
    )
);
